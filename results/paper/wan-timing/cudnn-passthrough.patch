+    void *symbol = handle ? dlsym(handle, name) : NULL;
+    if (!symbol) {
+        fprintf(stderr, "GX_REAL_CUDNN: cannot resolve %s: %s\n", name, dlerror());
+        abort();
+    }
+    /* dlclose balances the lookup reference; PyTorch retains cuDNN itself. */
+    dlclose(handle);
+    return symbol;
+}
