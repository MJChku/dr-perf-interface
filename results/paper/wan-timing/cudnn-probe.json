{
  "name": "wan-cudnn-probe",
  "hosts": [
    {
      "address": "ubuntu@icdslab2.epfl.ch",
      "containers": 1
    }
  ],
  "image": "gx-mixed-profile:rcp-20260915-110d87373a4a",
  "workspace": "/home/ubuntu/drperf-wan-timing",
  "resources": {
    "cpus": 8,
    "memory": "64g"
  },
  "network": {
    "name": "wan-timing-net",
    "manager": 0
  },
  "files": {
    "runner": "/home/ubuntu/drperf/examples/wan_gx/timing_model.py",
    "entry": "/home/ubuntu/drperf/examples/wan_gx/timing_entry.sh",
    "requirements": "/home/ubuntu/drperf/examples/wan_gx/dependencies.txt",
    "gpu_db": "/home/ubuntu/drperf/out/wan-timing/gpu-profile/merged.sqlite",
    "probe": "/home/ubuntu/drperf/examples/wan_gx/cudnn_probe.py"
  },
  "gxvm": {
    "mode": "plain",
    "attachment": "late",
    "epoch": {
      "ns": 10000
    }
  },
  "timeout_seconds": 3600,
  "application": {
    "cwd": "/workspace",
    "environment": {
      "GX_HOME": "/home/jma/GX",
      "GX_COMM_ONLY": "1",
      "GX_DEVICE_MODEL": "A100",
      "GX_NUM_LOCAL_GPUS": "1",
      "GX_SHM_ARENA_GB": "8",
      "GX_APP_REAL_MAX_BYTES": "16777216",
      "GX_CHROME_TRACE": "1",
      "GX_ID": "0",
      "GX_PROFILE_DB": "",
      "NEX_PROFILE_DB": "",
      "GX_PREDICT_DB": "{file:gpu_db}",
      "NEX_PREDICT_DB": "",
      "NCCL_SOCKET_IFNAME": "lo",
      "OMP_NUM_THREADS": "1",
      "MKL_NUM_THREADS": "1",
      "OPENBLAS_NUM_THREADS": "1",
      "PYTHONHASHSEED": "0",
      "LD_LIBRARY_PATH": "/home/jma/bridge-venv2/lib/python3.12/site-packages/nvidia/cudnn/lib",
      "CUDNN_LOGLEVEL_DBG": "3",
      "CUDNN_LOGDEST_DBG": "{run_dir}/cudnn.log"
    },
    "command": [
      "bash",
      "{file:entry}",
      "{file:requirements}",
      "python3",
      "{file:probe}"
    ]
  }
}
