{
  "name": "wan-cpu-clock",
  "hosts": [
    {
      "address": "ubuntu@icdslab2.epfl.ch",
      "containers": 1
    }
  ],
  "image": "gx-mixed-profile:rcp-20260915-110d87373a4a",
  "workspace": "/home/ubuntu/drperf-wan-timing",
  "resources": {
    "cpus": 8,
    "memory": "64g"
  },
  "network": {
    "name": "wan-timing-net",
    "manager": 0
  },
  "files": {
    "runner": "/home/ubuntu/drperf/examples/wan_gx/timing_model.py",
    "entry": "/home/ubuntu/drperf/examples/wan_gx/timing_entry.sh",
    "requirements": "/home/ubuntu/drperf/examples/wan_gx/dependencies.txt",
    "context_limits": "/home/ubuntu/drperf/out/wan-timing/gpu-profile/device-queries.tsv",
    "device_attributes": "/home/ubuntu/drperf/out/wan-timing/gpu-profile/device-queries-complete.attributes.tsv"
  },
  "gxvm": {
    "mode": "profile",
    "attachment": "late",
    "epoch": {
      "ns": 10000
    },
    "profile": {
      "output": "{run_dir}/profile-%p.db",
      "autostart": false,
      "instruction_period": 5000000,
      "task_period_ns": 5000000
    }
  },
  "timeout_seconds": 1200,
  "application": {
    "cwd": "/workspace",
    "environment": {
      "GX_HOME": "/home/jma/GX",
      "GX_COMM_ONLY": "1",
      "GX_DEVICE_MODEL": "A100",
      "GX_NUM_LOCAL_GPUS": "1",
      "GX_SHM_ARENA_GB": "8",
      "GX_APP_REAL_MAX_BYTES": "16777216",
      "GX_CHROME_TRACE": "1",
      "GX_ID": "0",
      "GX_PROFILE_DB": "",
      "NEX_PROFILE_DB": "",
      "GX_PREDICT_DB": "",
      "NEX_PREDICT_DB": "",
      "NCCL_SOCKET_IFNAME": "lo",
      "OMP_NUM_THREADS": "1",
      "MKL_NUM_THREADS": "1",
      "OPENBLAS_NUM_THREADS": "1",
      "PYTHONHASHSEED": "0",
      "CUDA_VISIBLE_DEVICES": "0",
      "LD_LIBRARY_PATH": "/home/jma/bridge-venv2/lib/python3.12/site-packages/nvidia/cudnn/lib",
      "GX_REAL_CUDNN": "1",
      "GX_CUDA_CONTEXT_LIMITS": "{file:context_limits}",
      "GX_CUDA_DEVICE_ATTRIBUTES": "{file:device_attributes}"
    },
    "command": [
      "bash",
      "{file:entry}",
      "{file:requirements}",
      "python3",
      "{file:runner}",
      "--role",
      "cpu-profile",
      "--tree",
      "/workspace/wan-gx/baseline",
      "--checkpoint",
      "/workspace/wan-gx/checkpoint",
      "--output",
      "{run_dir}/wan",
      "--frames",
      "81",
      "--steps",
      "50",
      "--warmup-steps",
      "4",
      "--conv-backend",
      "cudnn"
    ]
  },
  "runtime": {
    "gx_library": "/home/ubuntu/.cache/bazel/_bazel_ubuntu/b78dad33b85dc3f8255c797b3179e377/execroot/_main/bazel-out/k8-opt/bin/src/sims/gpu/gx_cuda.so"
  }
}
