#!/usr/bin/env python3
"""drperf COMMAND [ARGS...]

Run the marked program, fit CPU-cost interfaces, check declared waits, and
write drperf-report/report.txt, profile.drperf.json, and graph.html.

    drperf ./myapp
    drperf python3 app.py
    drperf --report [REPORT.json] --stats
    drperf --report [REPORT.json] --region REGION
    drperf --report [REPORT.json] --top unexplained --topk 10
    drperf --report [REPORT.json] --top costly --topk 10
    drperf --report [REPORT.json] --full

Report queries are read-only; add --json for structured output.

report.txt includes the text architecture graph, formulas, function breakdowns,
and unexplained waits. graph.html is the interactive human view. No separate
check, export, or graph command is needed. Declare conditions inline with wait(event, generation, indicator="entry PCV expression").
Legacy drperf.waits.json files remain supported.

Optional environment settings:
  DRPERF_REPORT_DIR     report directory (default: ./drperf-report)
  DRPERF_SOURCE_ROOT    source tree (default: working directory)
  DRPERF_WAIT_INTERFACES  legacy wait-declaration file
  DRPERF_WAITS=0        instruction-only capture

Ordinary runs never inject delays. Unexplained work remains feedback; failed
wait claims return 1, measurement/report errors return 2. The program's own
failure status is propagated.
"""
import os
import json
import sys
import tempfile

HERE = os.path.dirname(os.path.abspath(__file__))
ROOT = os.path.dirname(HERE)
sys.path.insert(0, os.path.join(ROOT, "lib"))
import runner   # noqa: E402


def main(argv):
    if argv and argv[0] == '--report':
        import report_query
        return report_query.main(argv[1:])
    if not argv or argv[0] in ("-h", "--help"):
        sys.stderr.write(__doc__)
        return 0 if argv else 2
    from pathlib import Path
    import explorer
    import report_bundle
    directory = Path(os.environ.get('DRPERF_REPORT_DIR', 'drperf-report'))
    destination = Path(os.environ.get('DRPERF_REPORT', str(directory/'profile.drperf.json')))
    source_root = Path(os.environ.get('DRPERF_SOURCE_ROOT', os.getcwd()))
    explicit = os.environ.get('DRPERF_WAIT_INTERFACES')
    declaration_path = Path(explicit) if explicit else Path('drperf.waits.json')
    try:
        declarations = json.loads(declaration_path.read_text()) if explicit or declaration_path.exists() else None
    except (OSError, ValueError) as error:
        sys.stderr.write('drperf: cannot read wait declarations: ' + str(error) + '\n')
        return 2
    with tempfile.TemporaryDirectory(prefix='drperf.') as temporary:
        raw = Path(temporary)/'run'
        try:
            rc, output, files = runner.run(argv, str(raw))
            if rc or not files:
                sys.stderr.write(output)
                if not files: sys.stderr.write('drperf: no marked region capture was produced.\n')
                return rc or 1
            model = explorer.build_model(raw, source_root, wait_declarations=declarations)
            model['provenance']['command'] = list(argv)
            paths = report_bundle.write(model, destination)
        except (OSError, ValueError, KeyError, TypeError) as error:
            sys.stderr.write('drperf: ' + str(error) + '\n')
            return 2
        # The persistent report contains the entire graph; keep terminal output
        # small even when the application contains hundreds of regions.
        event = model.get('eventModel', {})
        coverage = event.get('coverage', {})
        print(f'drperf: {len(model["regions"])} regions; wait checks: {event.get("status", "disabled")}')
        if 'obligations' in coverage:
            print(f'  Wait obligations: {coverage["covered"]}/{coverage["obligations"]} covered; '
                  f'{coverage["uncovered"]} unexplained')
        for label, path in paths.items(): print(f'  {label}: {path}')
        if model['validity']['errors'] or model['validity']['traceErrors'] or event.get('unverified'):
            return 2
        if event.get('violations') or event.get('interfaceChecks', {}).get('status') == 'invalid':
            return 1
        return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
