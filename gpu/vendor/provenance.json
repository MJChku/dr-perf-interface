  "adaptations": "GX PTX translation with predicated work counters and device-region markers, instrumentation ABI 3. Standalone per-CTA fibers/arenas with cluster/grid coordination. Canonical numerical MMA/WMMA/WGMMA/tcgen05/TMA/bulk and external-call adapters. Portable TMA coordinate temporaries and corrected bar/barrier reduction lowering. No new Lean proof of counter semantics.",
  "standalone_blackwell_port": {
    "upstream_revision": "cc6dfacbe333c7a5892c1247ad2d7f9c9f464d68",
    "patches": [
      "Use standalone context/dim3 instead of CUDA vector_types.h",
      "Semantic resource hooks at original PTX call sites; no counts in reference loops",
      "Reject CTA-group2 before executing; do not emulate unsupported clusters as group1",
      "Flag masked/sparse/weight-stationary/ashift/compressed-copy accounting incomplete"
    ],
    "tests": "Current validation: gpu/tests/test_gpu.py and gpu/tests/test_runtime_parity.py; includes BF16/NVFP4, paired CTA, masked incompleteness and invalid geometry rejection",
    "initial_scope": "CTA-group1 functional tcgen05 and mbarriers; complete implemented dense unmasked BF16/NVFP4 tile counters; no GPU latency inference",
    "superseded_by": "runtime_parity"
  },
  "device_regions": {
    "scope": "Source-level nested lane/warp/block annotations and device-computed integer PCVs; exclusive work ownership",
    "abi": "External __drperf_gpu_device_{begin,pcv,end}_v1 calls lowered to standalone collector hooks; no marker-call work counts",
    "compiler": "NVCC external declarations preserve parameters; native disabled macros or separately device-linked no-op stubs",
    "limitations": [
      "Cooperative scopes require all physical members and identical PCVs/nesting; no implicit barriers",
      "Parameter staging and PCV expression PTX is still counted; compiler optimizations may change",
      "No scoped-span or hardware-latency prediction; runtime collection changes have no new Lean proof"
    ],
    "tests": "python3 gpu/tests/test_gpu.py; NVCC compiler/native-link checks optional via NVCC environment variable; CPU/PTX execution only"
