 st.global.u32 [%d1],%r1;
 ret;
}
.visible .entry reduce(.param .u64 input, .param .u64 output, .param .u32 n)
{
 .shared .align 16 .b8 scratch[256];
 .reg .b32 %r<12>;
 .reg .b64 %d<8>;
 .reg .f32 %f<5>;
 .reg .pred %p<4>;
