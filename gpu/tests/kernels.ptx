 wmma.load.a.sync.aligned.row.m16n16k16.global.bf16 {%ra0,%ra1,%ra2,%ra3},[%rd0],16;
 wmma.load.b.sync.aligned.row.m16n16k16.global.bf16 {%rb0,%rb1,%rb2,%rb3},[%rd1],16;
 wmma.load.c.sync.aligned.row.m16n16k16.global.f32 {%fc0,%fc1,%fc2,%fc3,%fc4,%fc5,%fc6,%fc7},[%rd2],16;
 wmma.mma.sync.aligned.row.row.m16n16k16.f32.bf16.bf16.f32 {%fd0,%fd1,%fd2,%fd3,%fd4,%fd5,%fd6,%fd7},{%ra0,%ra1,%ra2,%ra3},{%rb0,%rb1,%rb2,%rb3},{%fc0,%fc1,%fc2,%fc3,%fc4,%fc5,%fc6,%fc7};
 wmma.store.d.sync.aligned.row.m16n16k16.global.f32 [%rd5],{%fd0,%fd1,%fd2,%fd3,%fd4,%fd5,%fd6,%fd7},16;
