+    @torch.no_grad()
+    def prepare_for_inference(self):
+        """Materialize parametrized weights after loading and final placement.
+
+        This is an opt-in, irreversible inference conversion: the resulting
+        state_dict stores plain weights. Reload the original model to train or
+        load a checkpoint that uses weight-normalization parametrizations.
+        """
+        if self.training:
+            raise RuntimeError("Call eval() before prepare_for_inference()")
+        from torch.nn.utils import parametrize
+        for module in self.modules():
+            if parametrize.is_parametrized(module, "weight"):
+                parametrize.remove_parametrizations(module, "weight", leave_parametrized=True)
+        return self
