+def apply_rotary_pos_emb(t, freqs, scale=1, precomputed=None):
+    if precomputed is None:
+        return _apply_rotary_pos_emb(t, freqs, scale)
+    # Match x-transformers' operation order and dtype, reusing only sin/cos.
+    with torch.autocast(device_type="cuda", enabled=False):
+        cos, sin = precomputed
+        rot_dim, seq_len, orig_dtype = freqs.shape[-1], t.shape[-2], t.dtype
+        cos, sin = cos[:, -seq_len:, :], sin[:, -seq_len:, :]
+        scale = scale[:, -seq_len:, :] if isinstance(scale, torch.Tensor) else scale
+        if t.ndim == 4 and cos.ndim == 3:
+            cos, sin = cos.unsqueeze(1), sin.unsqueeze(1)
+        t, t_unrotated = t[..., :rot_dim], t[..., rot_dim:]
+        t = (t * cos * scale) + (rotate_half(t) * sin * scale)
+        return torch.cat((t, t_unrotated), dim=-1).type(orig_dtype)
 
 
