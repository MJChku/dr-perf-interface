 # simplified version of the accelerate function https://github.com/huggingface/accelerate/blob/main/src/accelerate/utils/modeling.py
+_CPU_CAST_CACHE = os.environ.get("WANWRAPPER_CPU_CAST_CACHE") == "1"
+
+
+def _cached_cpu_cast(module, name, value, dtype, device):
+    """Reuse immutable CPU dtype conversions before inference weight uploads.
+
+    The cache adds host memory, not GPU residency. Source identity and tensor
+    versions invalidate entries. Training, CPU destinations and inference
+    tensors without version counters keep the original conversion path.
+    """
+    if (torch.is_grad_enabled() or value.requires_grad
+            or value.device.type != "cpu" or torch.device(device).type != "cuda"
+            or value.dtype == dtype or value.layout != torch.strided):
+        return value.to(dtype)
+    try:
+        version = value._version
+    except RuntimeError:
+        return value.to(dtype)
+    cache = getattr(module, "_wan_cpu_cast_cache", None)
+    entry = cache.get(name) if cache is not None else None
+    if (entry is not None and entry[0]() is value and entry[1] == version
+            and entry[2] == dtype and entry[3]._version == entry[4]):
+        return entry[3]
+    # ComfyUI executes nodes in inference_mode. Keep this CPU-only cache entry
+    # versioned so accidental in-place changes still invalidate it.
+    with torch.inference_mode(False), torch.no_grad():
+        result = value.to(dtype)
+    result_version = result._version
+    if cache is None:
+        cache = {}
+        module._wan_cpu_cast_cache = cache
+    cache[name] = (weakref.ref(value), version, dtype, result, result_version)
+    return result
+
