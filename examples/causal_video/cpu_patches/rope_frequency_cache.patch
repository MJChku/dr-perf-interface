+def _causal_rope_frequencies(freqs, f, h, w, start_frame, c):
+    """Reuse immutable position multipliers across query/key and denoise calls.
+
+    This is opt-in because it changes GPU launch inventory. Keep the source
+    tensor alive in each entry so an allocator cannot reuse its identity.
+    """
+    use_cache = _rope_frequency_cache_enabled and not torch.is_grad_enabled()
+    if use_cache:
+        # A frequency tensor moved to CUDA under inference_mode has no version
+        # counter. The model only assigns/replaces self.freqs; it never mutates it.
+        version = None if freqs.is_inference() else freqs._version
+        # Reuse only on the stream that produced the grid. Keep the stream in
+        # the entry so its identity remains valid for the cached tensor.
+        stream = torch.cuda.current_stream(freqs.device) if freqs.is_cuda else None
+        stream_id = stream.cuda_stream if stream is not None else None
+        key = (id(freqs), version, f, h, w, start_frame, c, stream_id)
+        with _rope_frequency_cache_lock:
+            entry = _rope_frequency_cache.get(key)
+            if entry is not None and entry[0] is freqs:
+                global _rope_frequency_cache_hits
+                _rope_frequency_cache_hits += 1
+                _rope_frequency_cache.move_to_end(key)
+                return entry[2]
+
+    split = freqs.split([c - 2 * (c // 3), c // 3, c // 3], dim=1)
+    expanded = torch.cat([
+        split[0][start_frame:start_frame + f].view(f, 1, 1, -1).expand(f, h, w, -1),
+        split[1][:h].view(1, h, 1, -1).expand(f, h, w, -1),
+        split[2][:w].view(1, 1, w, -1).expand(f, h, w, -1),
+    ], dim=-1).reshape(f * h * w, 1, -1)
+    if use_cache:
+        with _rope_frequency_cache_lock:
+            global _rope_frequency_cache_misses, _rope_frequency_cache_evictions
+            _rope_frequency_cache_misses += 1
+            _rope_frequency_cache[key] = (freqs, stream, expanded)
+            _rope_frequency_cache.move_to_end(key)
+            if len(_rope_frequency_cache) > _rope_frequency_cache_limit:
+                _rope_frequency_cache.popitem(last=False)
+                _rope_frequency_cache_evictions += 1
+    return expanded
+
 
