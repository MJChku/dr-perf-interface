+/* Probe only the output APIs that can feed CUDA 13/cuDNN launch setup.
+ * This diagnostic changes no status or output and is disabled by default. */
+static void gx_log_cudnn_output_probe(const char *api, const void *handle,
+                                      size_t index, const void *output_a,
+                                      const void *output_b) {
+    if (!getenv("GX_CUDNN_OUTPUT_PROBE")) return;
+    static unsigned int logged;
+    if (__sync_fetch_and_add(&logged, 1) < 128)
+        fprintf(stderr, "GX_CUDNN_OUTPUT_PROBE %s handle=%p index=%zu out_a=%p out_b=%p\n",
+                api, handle, index, output_a, output_b);
+}
