+#pragma once
+#include <dlfcn.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+/* Opt in only when the installed cuDNN library is the profiled build. */
+static inline int gx_real_cudnn_enabled(void) {
+    const char *value = getenv("GX_REAL_CUDNN");
+    return value && strcmp(value, "1") == 0;
+}
+
+extern void *(*orig_dlopen)(const char *, int);
+static inline void *gx_real_cudnn_symbol(const char *name) {
+    /* Bypass GX's dlopen replacement only for cuDNN host code. RTLD_DEEPBIND
+       is deliberately absent: CUDA calls must keep resolving through GX. */
+    void *handle = orig_dlopen("libcudnn.so.9", RTLD_LAZY | RTLD_LOCAL);
+    void *symbol = handle ? dlsym(handle, name) : NULL;
+    if (!symbol) {
+        fprintf(stderr, "GX_REAL_CUDNN: cannot resolve %s: %s\n", name, dlerror());
+        abort();
+    }
+    /* dlclose balances the lookup reference; PyTorch retains cuDNN itself. */
+    dlclose(handle);
+    return symbol;
+}
+
+/* Batched cuBLAS calls must execute real host dispatch: the default GX stubs
+ * omit T5's attention kernels entirely. CUDA launches still resolve to GX. */
+static inline void *gx_real_cublas_symbol(const char *name) {
+    void *handle = orig_dlopen("libcublas.so.12", RTLD_LAZY | RTLD_LOCAL);
+    void *symbol = handle ? dlsym(handle, name) : NULL;
+    if (!symbol) {
+        fprintf(stderr, "GX_REAL_CUDNN: cannot resolve cuBLAS %s: %s\n", name, dlerror());
+        abort();
+    }
+    dlclose(handle);
+    return symbol;
+}
