# build products
build/
client/build/
perfmark/libperfmark.so
examples/*/bin/
examples/*/target/
examples/*/target-delta/
**/__pycache__/
*.pyc
*.o
*.so

# profiling output
out/
*.json.trace
*.json.blocks
*.json.slots

# third-party trees fetched or built locally (see third_party/*.sh)
third_party/dynamorio
third_party/DynamoRIO-*/
third_party/*.tar.gz
third_party/vllm-cpu/vllm/
third_party/vllm-cpu/.venv/
third_party/vllm-cpu/*.log
third_party/hf/

# working notes for the coding agent, not part of the tool
CLAUDE.md
.claude/

# internal brief for the coding session, not part of the tool
TASK.md

# development front end, not part of the released tool
tools/drperf-dev
lib/symcost.py
perfmark/python/perfmark_boot.py

# VS Code explorer dependencies and packaged development artifacts
extensions/vscode/node_modules/
extensions/vscode/.vscode-test/
extensions/vscode/*.vsix
extensions/vscode/test-results/

# Default one-command report bundle
drperf-report/

# measured_cases: generated trees and runs
examples/measured_cases/work/
examples/measured_cases/out/
# local evaluation scratch and resumable controller state
bench_manual/
bench_correct_*/**/.controller-runs/
bench_correct_*/**/.runner.lock
bench_correct_*/**/interactive-run.log
