{
  "type": "object",
  "additionalProperties": false,
  "required": ["attempts", "selected_variables", "final_formula", "final_irregularity"],
  "properties": {
    "attempts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["attempt", "variables", "formula", "irregularity", "status"],
        "properties": {
          "attempt": {"type": "integer", "minimum": 1},
          "variables": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "formula": {"type": ["string", "null"]},
          "irregularity": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
          "status": {"type": "string", "enum": ["ok", "insufficient_state_variation", "region_not_reached", "workload_failed", "invalid_measurement", "state_mismatch", "drperf_not_built", "measurement_error"]}
        }
      }
    },
    "selected_variables": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "final_formula": {"type": ["string", "null"]},
    "final_irregularity": {"type": ["number", "null"], "minimum": 0, "maximum": 1}
  }
}
