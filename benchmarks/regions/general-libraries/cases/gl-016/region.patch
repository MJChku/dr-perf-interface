+                    # For inactive reverse edges: cap == flow == 0 -> removed.
+                    # For active reverse edges: cap=0, flow < 0 -> cap != flow
+                    #   -> kept (these have positive residual capacity and
+                    #   represent cancellable flow in the residual graph).
+                    saturated_edges = [
