+# Per-request cache of already-converted output token ids.  Rebuilding the
+# padded tensor from the Python lists costs ~310 instructions for every token
+# generated so far, on *every* decode step, so the per-step cost grows with the
+# total number of generated tokens.  A request's tokens only ever grow at the
+# tail, so convert each token to numpy exactly once, keep it in a per-request
+# int64 array, and fill the padded matrix with numpy->numpy row copies.
+#
+# Keyed by ``id()`` of the request's output-token list.  The entry holds a
+# strong reference to that list, so its id cannot be reused by a different live
+# list while the entry exists.  The cache is pruned to the current batch once it
+# grows past it, so it never holds more than a bounded number of entries.
+#
+# Entry layout: [tokens_list, int64 array, num_cached]
+_OUTPUT_TOKEN_CACHE: dict[int, list] = {}
+
+
+def _padded_output_tokens(output_token_ids: list[list[int]], pad: int) -> np.ndarray:
+    global _OUTPUT_TOKEN_CACHE
+
+    num_reqs = len(output_token_ids)
+    max_len = max(map(len, output_token_ids), default=0)
+    padded = np.full((num_reqs, max_len), pad, dtype=np.int64)
+
+    cache = _OUTPUT_TOKEN_CACHE
+    if len(cache) > 2 * num_reqs + 8:
+        # Drop entries for requests that have left the batch.
+        keys = set(map(id, output_token_ids))
+        cache = _OUTPUT_TOKEN_CACHE = {k: v for k, v in cache.items() if k in keys}
+
+    for i, tokens in enumerate(output_token_ids):
+        num_tokens = len(tokens)
+        if not num_tokens:
+            continue
+        key = id(tokens)
+        entry = cache.get(key)
+        if entry is None or entry[0] is not tokens:
+            entry = cache[key] = [tokens, np.empty(max(num_tokens, 32), np.int64), 0]
+
+        num_cached = entry[2]
+        if num_cached > num_tokens:
+            # The list was truncated in place (rejected speculative tokens, or
+            # tokens dropped after a KV-load failure) or cleared.  Truncation
+            # never alters the surviving prefix.
+            num_cached = entry[2] = num_tokens
+        if num_cached < num_tokens:
+            arr = entry[1]
+            if arr.shape[0] < num_tokens:
+                grown = np.empty(max(num_tokens, 2 * arr.shape[0]), np.int64)
+                grown[:num_cached] = arr[:num_cached]
+                arr = entry[1] = grown
+            # A -1 placeholder, and anything after it, is never treated as
+            # final: in the async-scheduling case the trailing placeholder run
+            # is overwritten in place once the real sampled ids arrive.
+            if num_tokens == num_cached + 1:
+                # Common case: exactly one new token.
+                token = tokens[num_cached]
+                arr[num_cached] = token
+                entry[2] = num_cached if token == -1 else num_tokens
+            else:
+                tail = tokens[num_cached:num_tokens]
+                arr[num_cached:num_tokens] = tail
+                if -1 in tail:
+                    entry[2] = num_cached + tail.index(-1)
+                else:
+                    entry[2] = num_tokens
+
+        padded[i, :num_tokens] = entry[1][:num_tokens]
+
+    return padded
+
+
