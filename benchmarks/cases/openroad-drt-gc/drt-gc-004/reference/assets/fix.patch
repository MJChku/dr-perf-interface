+// GC_NETCTOR. Every gcNet the worker creates used to construct seven vectors
+// of numLayers elements (fixed and route polygon sets, fixed and route cut
+// rectangles, pins, tapered and non-tapered rectangles): seven allocations and
+// 7 x numLayers element constructions per net, and as many destructions later,
+// whether the net holds one shape or none. With the gate on, a kind's vector
+// is sized on the first add to that kind; until then every getter reads a
+// shared, never written vector of numLayers default-constructed elements (one
+// per layer count). Per-layer getters read through a per-kind data pointer in
+// both modes, and keep the bounds check vector::operator[] makes under
+// _GLIBCXX_ASSERTIONS.
+//
+// Equivalence: a kind not yet sized has had no add since construction, so in
+// the original every layer of it is a default-constructed element; the shared
+// vector has the same length and default-constructed elements, so every
+// getter returns an equal value (sizes, iteration, contents, polygon set
+// orientation and dirty/sorted state). The shared objects are never written:
+// the only mutators of a gcNet's per-layer data are the add methods, which
+// write the net's own members, and const reads of a pristine polygon set do
+// not modify it (clean() and sort() test their flags first). Callers do not keep a getter reference across an add to the same net
+// and kind, so the different address of an untouched layer is not observable.
+// Sizing on first add creates numLayers default-constructed elements, the state
+// the constructor produced. Gate read once from the environment: unset or 0 =
+// original eager construction.
+inline bool gcNetCtorLazy()
+{
+  static const bool lazy = [] {
+    const char* v = std::getenv("GC_NETCTOR");
+    return v != nullptr && v[0] != '\0' && v[0] != '0';
+  }();
+  return lazy;
+}
+
+// Default-constructed per-layer containers shared by every lazily sized gcNet
+// with the same layer count. Never written.
+struct gcNetEmptyLayers
+{
+  explicit gcNetEmptyLayers(int n)
+      : numLayers(n), polygons(n), rectangles(n), pins(n), rects(n)
+  {
+  }
+  const int numLayers;
+  const std::vector<gtl::polygon_90_set_data<frCoord>> polygons;
+  const std::vector<std::vector<gtl::rectangle_data<frCoord>>> rectangles;
+  const std::vector<std::vector<std::unique_ptr<gcPin>>> pins;
+  const std::vector<std::vector<odb::Rect>> rects;
+};
+
+inline const gcNetEmptyLayers& gcNetEmpties(int numLayers)
+{
+  static std::atomic<const gcNetEmptyLayers*> last{nullptr};
+  const gcNetEmptyLayers* e = last.load(std::memory_order_acquire);
+  if (e != nullptr && e->numLayers == numLayers) {
+    return *e;
+  }
+  static std::mutex mu;
+  std::lock_guard<std::mutex> lock(mu);
+  // one per distinct layer count, never freed (outlives every gcNet)
+  static auto* all = new std::vector<const gcNetEmptyLayers*>();
+  for (const gcNetEmptyLayers* p : *all) {
+    if (p->numLayers == numLayers) {
+      last.store(p, std::memory_order_release);
+      return *p;
+    }
+  }
+  all->push_back(new gcNetEmptyLayers(numLayers));
+  last.store(all->back(), std::memory_order_release);
+  return *all->back();
+}
