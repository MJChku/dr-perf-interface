+// ------------------------------------------------------------ GC_EMPTYLAYERS
+//
+// initNet() runs four passes and each walks every layer of the technology
+// (21 here), building polygon sets, extracting polygons, computing maximal
+// rectangles and constructing per-layer std::sets for all of them, while a
+// net's shapes usually sit on one to three layers. With the gate on:
+//  a) the layers where the net has content (a route or fixed polygon, a route
+//     or fixed cut rectangle, or a pin) are recorded once per initNet(), and
+//     every per-layer loop of the passes walks only those, in ascending order;
+//  b) within them, reads of a kind that holds nothing are skipped: get() of an
+//     empty fixed polygon set (fixed edges, vertex cache),
+//     get_max_rectangles() of it, and the pin merge of a layer without
+//     polygons (its vector of merge sets is sized at the first layer that has
+//     polygons);
+//  c) the per-layer std::set vectors of the edge and maximal-rectangle passes
+//     and the corner pass's vertex-cache vector are per-thread, handed out
+//     empty and emptied again, on the visited layers, when the pass ends.
+//
+// Equivalence: a polygon set without vertex data was never added to, so it is
+// in its default state; get(), get_max_rectangles() and += of it produce
+// nothing and change nothing. A layer without content has no polygon, cut
+// rectangle or pin, so every loop body over it does nothing: no pin is
+// created, no fixed edge, rectangle or vertex is recorded, and no pin is
+// visited. Pins are only added on layers that have polygons or cut
+// rectangles, and no shape list changes during initNet(), so the recorded
+// layers stay exactly the layers with content. Layers are visited in the same
+// ascending order, so pins get the same ids and every container the same
+// insertion order. Reused sets and caches are empty when handed out, as fresh
+// ones are, and only visited layers are written. More than 64 layers, or a
+// pass called outside initNet(): every layer is walked (b and c still apply).
+// Gate read once from the environment: unset or 0 = original.
+namespace {
+
+bool emptyLayersEnabled()
+{
+  static const bool enabled = [] {
+    const char* v = std::getenv("GC_EMPTYLAYERS");
+    return v != nullptr && v[0] != '\0' && v[0] != '0';
+  }();
+  return enabled;
+}
+
+// The layers one pass visits: all of them, or the set bits of mask.
+struct LayerRange
+{
+  uint64_t mask = 0;
+  bool active = false;
+  int numLayers = 0;
+
+  template <typename F>
+  void forEach(F&& f) const
+  {
+    if (active) {
+      for (uint64_t m = mask; m != 0; m &= m - 1) {
+        f(__builtin_ctzll(m));
+      }
+    } else {
+      for (int i = 0; i < numLayers; i++) {
+        f(i);
+      }
+    }
+  }
+};
+
+struct EmptyLayersState
+{
+  const gcNet* net = nullptr;
+  int numLayers = 0;
+  uint64_t mask = 0;
+};
+thread_local EmptyLayersState* emptyLayersActive = nullptr;
+
+inline bool layerHasContent(const gcNet* net, int i)
+{
+  return !net->getPolygons(i, false).value().empty()
+         || !net->getPolygons(i, true).value().empty()
+         || !net->getRectangles(i, false).empty()
+         || !net->getRectangles(i, true).empty() || !net->getPins(i).empty();
+}
+
+// Valid for one initNet(): records the layers with content when it begins.
+class EmptyLayersScope
+{
+ public:
+  EmptyLayersScope(const gcNet* net, int numLayers)
+  {
+    if (!emptyLayersEnabled() || numLayers > 64) {
+      return;
+    }
+    uint64_t mask = 0;
+    for (int i = 0; i < numLayers; i++) {
+      if (layerHasContent(net, i)) {
+        mask |= uint64_t(1) << i;
+      }
+    }
+    state_.net = net;
+    state_.numLayers = numLayers;
+    state_.mask = mask;
+    prev_ = emptyLayersActive;
+    emptyLayersActive = &state_;
+    active_ = true;
+  }
+  ~EmptyLayersScope()
+  {
+    if (active_) {
+      emptyLayersActive = prev_;
+    }
+  }
+  EmptyLayersScope(const EmptyLayersScope&) = delete;
+  EmptyLayersScope& operator=(const EmptyLayersScope&) = delete;
+
+ private:
+  EmptyLayersState state_;
+  EmptyLayersState* prev_ = nullptr;
+  bool active_ = false;
+};
+
+LayerRange layersOf(const gcNet* net, int numLayers)
+{
+  LayerRange range;
+  range.numLayers = numLayers;
+  const EmptyLayersState* st = emptyLayersActive;
+  if (st != nullptr && st->net == net && st->numLayers == numLayers) {
+    range.mask = st->mask;
+    range.active = true;
+  }
+  return range;
+}
+
+// A vector of numLayers default-constructed T for one pass: fresh when the
+// gate is off, otherwise a per-thread vector handed out with every element
+// empty and emptied again, on the visited layers, when the pass ends.
+template <typename T>
+class LayerScratch
+{
+ public:
+  LayerScratch(int numLayers, const LayerRange& layers)
+      : layers_(layers), own_(emptyLayersEnabled() ? 0 : numLayers)
+  {
+    if (!emptyLayersEnabled()) {
+      return;
+    }
+    thread_local Slot slot;
+    if (slot.busy) {  // nested use on this thread: a fresh vector
+      own_.resize(numLayers);
+      return;
+    }
+    slot.busy = true;
+    slot_ = &slot;
+    if (static_cast<int>(slot.v.size()) != numLayers) {
+      slot.v.clear();
+      slot.v.resize(numLayers);
+    }
+  }
+  ~LayerScratch()
+  {
+    if (slot_ == nullptr) {
+      return;
+    }
+    layers_.forEach([&](int i) { slot_->v[i] = T(); });
+    slot_->busy = false;
+  }
+  LayerScratch(const LayerScratch&) = delete;
+  LayerScratch& operator=(const LayerScratch&) = delete;
+  std::vector<T>& get() { return slot_ != nullptr ? slot_->v : own_; }
+
+ private:
+  struct Slot
+  {
+    std::vector<T> v;
+    bool busy = false;
+  };
+  const LayerRange layers_;
+  Slot* slot_ = nullptr;
+  std::vector<T> own_;
+};
+}  // namespace
