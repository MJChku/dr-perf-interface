+// ------------------------------------------------------------ GC_FIXEDPOLYS
+//
+// Within one initNet() a net's fixed polygons do not change, yet three passes
+// rebuild them from the fixed polygon set, each a Boost.Polygon clean and
+// polygon formation: the fixed-edge set (polygonEdges), the fixed-vertex cache
+// (polygonCorners) and get_max_rectangles over the set (maxRectangles), which
+// copies and re-merges it. With the gate on:
+//  1. the first pass that needs a layer's fixed polygons extracts them once
+//     and the others reuse the list; maximal rectangles are taken per polygon;
+//  2. on a layer where the net has no route polygon and no route rectangle
+//     (an all-fixed layer: obstructions, pins nothing is routed to), its pins
+//     are exactly its fixed shapes, so every pin edge, corner and maximal
+//     rectangle there is fixed; such layers skip the fixed-edge set, the
+//     vertex cache and the fixed maximal rectangles, and their lookups;
+//  3. the pin merge of a layer where only one of the route and fixed sets has
+//     polygons takes that set's polygons directly, and a pin that is a
+//     rectangle is its own only maximal rectangle.
+//
+// Equivalence: (1) edges and corners read exactly the list get() returns.
+// Merged polygons have disjoint interiors and share no edge, so no maximal
+// rectangle spans two of them, and the union of the per-polygon maximal
+// rectangles is the set's; the result only fills a std::set used for
+// membership, so order does not matter. (2) With no route shape on the layer,
+// the merged pins are the fixed polygon set's polygons (routing layer) or the
+// fixed rectangles (cut layer): each pin edge is an edge of a fixed polygon or
+// rectangle, each pin vertex a fixed vertex, each convex cut corner its own
+// rectangle's corner and each concave one lies in no route rectangle, and each
+// pin maximal rectangle is a maximal rectangle of the fixed set. So the
+// original lookups all answer "fixed". Corners the original leaves unset
+// (cut layer, neither convex nor concave) stay unset. (3) Merging a set with
+// an empty set and forming polygons gives the polygons of the set itself, and
+// get_max_rectangles of a rectangle is that rectangle.
+// Gate read once from the environment: unset or 0 = original.
+namespace {
+using PolyList = std::vector<gtl::polygon_90_with_holes_data<frCoord>>;
+
+bool fixedPolysEnabled()
+{
+  static const bool enabled = [] {
+    const char* v = std::getenv("GC_FIXEDPOLYS");
+    return v != nullptr && v[0] != '\0' && v[0] != '0';
+  }();
+  return enabled;
+}
+
+struct FixedPolysState
+{
+  const gcNet* net = nullptr;
+  std::vector<PolyList> polys;          // per layer, valid when ready
+  std::vector<char> ready;
+  std::vector<signed char> allFixed;    // per layer: -1 unknown, 0 no, 1 yes
+};
+
+// Hot-path state is a plain pointer, valid inside one initNet() only.
+thread_local FixedPolysState* fixedPolysActive = nullptr;
+
+class FixedPolysScope
+{
+ public:
+  FixedPolysScope(const gcNet* net, int numLayers)
+  {
+    if (!fixedPolysEnabled()) {
+      return;
+    }
+    thread_local FixedPolysState storage;
+    storage.net = net;
+    if (static_cast<int>(storage.polys.size()) < numLayers) {
+      storage.polys.resize(numLayers);
+    }
+    storage.ready.assign(numLayers, 0);
+    storage.allFixed.assign(numLayers, -1);
+    fixedPolysActive = &storage;
+  }
+  ~FixedPolysScope()
+  {
+    if (fixedPolysActive != nullptr) {
+      fixedPolysActive->net = nullptr;
+      fixedPolysActive = nullptr;
+    }
+  }
+  FixedPolysScope(const FixedPolysScope&) = delete;
+  FixedPolysScope& operator=(const FixedPolysScope&) = delete;
+};
+
+// The fixed polygons of net on layer, extracted on first use; nullptr when
+// the gate is off.
+const PolyList* fixedPolysFor(const gcNet* net, frLayerNum layer)
+{
+  FixedPolysState* st = fixedPolysActive;
+  if (st == nullptr || st->net != net) {
+    return nullptr;
+  }
+  PolyList& polys = st->polys[layer];
+  if (!st->ready[layer]) {
+    polys.clear();
+    net->getPolygons(layer, true).get(polys);
+    st->ready[layer] = 1;
+  }
+  return &polys;
+}
+
+// True when the gate is on and net has no route polygon and no route
+// rectangle on layer.
+inline bool allFixedLayer(const gcNet* net, frLayerNum layer)
+{
+  FixedPolysState* st = fixedPolysActive;
+  if (st == nullptr || st->net != net) {
+    return false;
+  }
+  signed char& e = st->allFixed[layer];
+  if (e < 0) {
+    e = (net->getPolygons(layer, false).value().empty()
+         && net->getRectangles(layer, false).empty())
+            ? 1
+            : 0;
+  }
+  return e == 1;
+}
