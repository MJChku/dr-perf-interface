+    def _project_text(self, encoder_hidden_states: torch.Tensor) -> torch.Tensor:
+        """`self.text_embedder(encoder_hidden_states)`, memoised on the input tensor.
+
+        The prompt embedding is fixed for a whole pipeline call, but this module is
+        entered once per denoising step and per classifier-free-guidance branch, so
+        the projection is recomputed for an unchanged input tens of times.  Key the
+        result on the identity of the input tensor (plus its `_version`, so an
+        in-place edit invalidates it); at most a handful of distinct prompts are
+        live at once (cond / uncond), and entries are held weakly.
+        """
+        if torch.is_grad_enabled():
+            return self.text_embedder(encoder_hidden_states)
+
+        version = encoder_hidden_states._version
+        live, hit = [], None
+        for ref, cached_version, cached in self._text_proj_cache:
+            src = ref()
+            if src is None:
+                continue
+            live.append((ref, cached_version, cached))
+            if src is encoder_hidden_states and cached_version == version:
+                hit = cached
+        if hit is not None:
+            self._text_proj_cache = live
+            return hit
+
+        projected = self.text_embedder(encoder_hidden_states)
+        self._text_proj_cache = [(weakref.ref(encoder_hidden_states), version, projected)] + live[:3]
+        return projected
+
