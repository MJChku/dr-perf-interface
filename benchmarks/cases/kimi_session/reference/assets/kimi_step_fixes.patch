 def _convert_message(message: Message) -> ChatCompletionMessageParam:
+    """Convert one history message, memoised per message instance.
+
+    Every step re-converts the whole conversation, and the conversion deep-copies
+    the message before dumping it. History messages are immutable once appended
+    (normalization builds new objects for the pairs it merges), so the result is
+    cached against the instance. The entry holds a strong reference to the
+    message, so its id cannot be reused while the entry lives. A shallow copy is
+    returned so a caller that mutates the top-level dict cannot corrupt the cache.
+    """
+    key = id(message)
+    hit = _MESSAGE_PARAM_CACHE.get(key)
+    if hit is not None and hit[0] is message:
+        return cast("ChatCompletionMessageParam", dict(hit[1]))
+    converted = _convert_message_uncached(message)
+    if len(_MESSAGE_PARAM_CACHE) > 4096:
+        _MESSAGE_PARAM_CACHE.clear()
+    _MESSAGE_PARAM_CACHE[key] = (message, converted)
+    return cast("ChatCompletionMessageParam", dict(converted))
+
+
