+class _LazyBlockHashes:
+    """Non-data descriptor backing `Request.block_hashes`.
+
+    The prompt's block hashes cost one pickle + SHA-256 per `hash_block_size`
+    tokens, and no consumer needs them until the request is first scheduled
+    (`KVCacheManager.get_computed_blocks`, `BlockPool.cache_full_blocks`, and
+    the KV connectors, all of which run from `Scheduler.schedule`).  Computing
+    them on the first read instead of in `Request.__init__` keeps admission
+    linear in the prompt length instead of paying that staircase per block.
+
+    This is deliberately a *non-data* descriptor (no `__set__`): the instance
+    attribute installed by the first read shadows it, so every later
+    `request.block_hashes` is a plain instance-dict lookup, exactly as when
+    the list was assigned in `__init__`.
+    """
+
+    __slots__ = ()
+
+    def __get__(self, request, owner=None):
+        if request is None:
+            return self
+        block_hashes = []
+        # Install the list *before* calling the hasher: the hasher reads
+        # `request.block_hashes` (its length, and its last element as the
+        # parent hash) and must see the same empty list it saw when this ran
+        # at the end of `__init__`.
+        request.__dict__["block_hashes"] = block_hashes
+        block_hasher = request._block_hasher
+        if block_hasher is not None:
+            block_hashes.extend(block_hasher(request))
+        return block_hashes
+
+
 class Request:
