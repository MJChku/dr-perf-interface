         seq_lens = mask.gt(0).sum(dim=1).long()
 
-        prompt_embeds = self.text_encoder(text_input_ids.to(device), mask.to(device)).last_hidden_state
+        # The encoder does not need the padding.  `padding="max_length"` above pads
+        # every prompt to `max_sequence_length` (512), and the encoder is then run on
+        # all 512 positions although the slice below keeps only `seq_lens` of them.
+        # T5 shifts masked scores by finfo.min and its position bias is relative, so
+        # each real token's output is independent of how many pad positions follow it:
+        # run the encoder on the longest REAL length instead, rounded up to a multiple
+        # of 8 (floor 16, below which BLAS switches to a small-matrix kernel and the
+        # result moves in the last fp32 ulp).  The slice-and-zero-pad below restores
+        # the (batch, max_sequence_length, dim) shape unchanged.
+        n_pad = int(seq_lens.max().item()) if seq_lens.numel() else 0
+        n_pad = min(max(-(-n_pad // 8) * 8, 16), max_sequence_length)
+        prompt_embeds = self.text_encoder(
+            text_input_ids[:, :n_pad].to(device), mask[:, :n_pad].to(device)
+        ).last_hidden_state
         prompt_embeds = prompt_embeds.to(dtype=dtype, device=device)
         prompt_embeds = [u[:v] for u, v in zip(prompt_embeds, seq_lens)]
