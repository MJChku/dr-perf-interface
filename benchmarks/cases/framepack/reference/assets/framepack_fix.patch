+class IncrementalMp4Writer:
+    """Write a video to one MP4 as frames become final, instead of re-encoding it.
+
+    FramePack builds the video a section at a time and, after each section, wrote the
+    whole accumulated video again. The frames handed to the codec are identical either
+    way and in the same order; the only difference is that they are handed over once.
+
+    The file is fragmented per frame and flushed, so it stays a playable MP4 while it
+    is still being written; that is what keeps the per-section preview working without
+    closing and reopening the container. The preview trails the run by the encoder's
+    lookahead, roughly one section, and appears from the second section onward.
+    """
+
+    def __init__(self, output_filename, fps=30, crf=16):
+        import av
+        import os
+
+        os.makedirs(os.path.dirname(os.path.abspath(os.path.realpath(output_filename))),
+                    exist_ok=True)
+        self._av = av
+        self.output_filename = output_filename
+        self.fps = fps
+        self.crf = crf
+        self.container = None
+        self.stream = None
+        self.written = 0
+
+    def _ensure_stream(self, height, width):
+        if self.container is not None:
+            return
+        # frag_every_frame emits a fragment per packet and flush_packets pushes it to
+        # disk, so the part written so far stays a decodable MP4 while the run continues.
+        # Both are container settings; the encoded video is byte-for-byte unaffected.
+        self.container = self._av.open(
+            self.output_filename, mode="w",
+            options={"movflags": "empty_moov+frag_every_frame", "flush_packets": "1"},
+        )
+        self.stream = self.container.add_stream("libx264", rate=self.fps)
+        self.stream.height = height
+        self.stream.width = width
+        self.stream.pix_fmt = "yuv420p"
+        self.stream.options = {"crf": str(int(self.crf))}
+
+    def append_bcthw(self, x):
+        """Append frames, given the same b,c,t,h,w tensor layout save_bcthw_as_mp4 took."""
+        import einops
+        import torch
+
+        b, c, t, h, w = x.shape
+        if t == 0:
+            return
+        per_row = b
+        for p in [6, 5, 4, 3, 2]:
+            if b % p == 0:
+                per_row = p
+                break
+        x = torch.clamp(x.float(), -1., 1.) * 127.5 + 127.5
+        x = x.detach().cpu().to(torch.uint8)
+        x = einops.rearrange(x, '(m n) c t h w -> t (m h) (n w) c', n=per_row)
+        self._ensure_stream(x.shape[1], x.shape[2])
+        for frame in x.numpy():
+            packet = self.stream.encode(
+                self._av.VideoFrame.from_ndarray(frame, format="rgb24")
+            )
+            self.container.mux(packet)
+        self.written += t
+
+    def flush(self):
+        """Make what has been written so far readable, without ending the video.
+
+        With `frag_keyframe+empty_moov` each fragment is already written as it is
+        muxed, so this only nudges the container where the binding offers a way to.
+        """
+        if self.container is None:
+            return
+        for name in ("flush_packets", "flush"):
+            method = getattr(self.container, name, None)
+            if callable(method):
+                try:
+                    method()
+                except Exception:
+                    pass
+                return
+
+    def close(self):
+        if self.container is None:
+            return
+        self.container.mux(self.stream.encode())
+        self.container.close()
+        self.container = None
+
+
