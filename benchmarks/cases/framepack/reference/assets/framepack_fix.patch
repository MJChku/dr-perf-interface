+class ReverseChunkMp4Writer:
+    """Encode each frame once when the video is built back to front.
+
+    demo_gradio.py's anti-drifting sampler generates the video in reverse: each section
+    is prepended, so the tail settles first and the file grows at the front. Frames
+    cannot simply be appended to one stream, but they still only need encoding once.
+
+    Each section's newly-settled frames are encoded to their own chunk, and the chunks
+    are joined by copying compressed packets, which never re-encodes anything. Only the
+    first `overlap` frames stay provisional, because the next section blends into them.
+    """
+
+    def __init__(self, output_filename, fps=30, crf=16, tmp_dir=None):
+        import os
+
+        self.output_filename = output_filename
+        self.fps = fps
+        self.crf = crf
+        self.tmp_dir = tmp_dir or (os.path.splitext(output_filename)[0] + "_chunks")
+        os.makedirs(self.tmp_dir, exist_ok=True)
+        self.chunks = []       # in final video order
+        self.written_tail = 0  # frames at the end already encoded
+        self.encoded = 0
+
+    def add_settled(self, history_pixels, overlap, is_last_section):
+        """Encode whatever became final, given the whole history so far."""
+        import os
+
+        total = history_pixels.shape[2]
+        start = 0 if is_last_section else overlap
+        end = total - self.written_tail
+        if end <= start:
+            return
+        path = os.path.join(self.tmp_dir, f"chunk_{len(self.chunks):04d}.mp4")
+        save_bcthw_as_mp4(history_pixels[:, :, start:end], path, fps=self.fps, crf=self.crf)
+        self.chunks.insert(0, path)
+        self.written_tail = total - start
+        self.encoded += end - start
+
+    def assemble(self):
+        """Join the chunks by copying packets. No frame is encoded a second time."""
+        import av
+
+        if not self.chunks:
+            return self.output_filename
+        out = av.open(self.output_filename, mode="w")
+        ostream = None
+        offset = 0
+        for path in self.chunks:
+            inp = av.open(path)
+            istream = inp.streams.video[0]
+            if ostream is None:
+                ostream = _add_stream_from_template(out, istream)
+            last_end = 0
+            for packet in inp.demux(istream):
+                if packet.dts is None:
+                    continue
+                packet.stream = ostream
+                if packet.pts is not None:
+                    packet.pts += offset
+                packet.dts += offset
+                last_end = max(last_end, (packet.pts or packet.dts) + (packet.duration or 0))
+                out.mux(packet)
+            offset = last_end
+            inp.close()
+        out.close()
+        return self.output_filename
+
+    def cleanup(self):
+        import shutil
+
+        shutil.rmtree(self.tmp_dir, ignore_errors=True)
+
