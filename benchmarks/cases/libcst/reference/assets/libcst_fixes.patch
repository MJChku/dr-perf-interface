+/// One suffix in a `primary` chain: `.attr`, `(...)`, a generator-expression call,
+/// or `[...]`. Collecting these and folding left replaces the left-recursive rule,
+/// whose seed growing re-cloned the whole expression once per link.
+enum PrimaryTail<'input, 'a> {
+    Attribute(TokenRef<'input, 'a>, Name<'input, 'a>),
+    GenExp(GeneratorExp<'input, 'a>),
+    Call(TokenRef<'input, 'a>, Vec<Arg<'input, 'a>>, TokenRef<'input, 'a>),
+    Subscript(
+        LeftSquareBracket<'input, 'a>,
+        Vec<SubscriptElement<'input, 'a>>,
+        RightSquareBracket<'input, 'a>,
+    ),
+}
+
+fn apply_primary_tail<'input, 'a>(
+    value: Expression<'input, 'a>,
+    tail: PrimaryTail<'input, 'a>,
+) -> Expression<'input, 'a> {
+    match tail {
+        PrimaryTail::Attribute(dot, attr) => {
+            Expression::Attribute(Box::new(make_attribute(value, dot, attr)))
+        }
+        PrimaryTail::GenExp(genexp) => {
+            Expression::Call(Box::new(make_genexp_call(value, genexp)))
+        }
+        PrimaryTail::Call(lpar, args, rpar) => {
+            Expression::Call(Box::new(make_call(value, lpar, args, rpar)))
+        }
+        PrimaryTail::Subscript(lbrak, slices, rbrak) => {
+            Expression::Subscript(Box::new(make_subscript(value, lbrak, slices, rbrak)))
+        }
+    }
+}
